{
  "name": "udyam-setu",
  "version": "1.0.0",
  "description": "Udyam Setu - AI-Driven Business Advisory & Financial Structuring Platform (SIH 2026)",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "node backend/src/index.js",
    "start:frontend": "cd frontend && npm run dev",
    "test": "node --test backend/tests/**/*.test.js",
    "build": "cd frontend && npm run build"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
